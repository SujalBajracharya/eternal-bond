# ============================================================
# Eternal Bond — Frontend Environment Variables (Vite)
# ============================================================
# Copy this file to .env and fill in your own values.

# ---- Supabase (Frontend) ----
# Supabase project reference ID (visible in the project URL, not secret)
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id

# Supabase anon/publishable key — this is PUBLIC by design (safe to expose in browser)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Supabase project URL (not secret)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# ---- Backend API ----
# URL where the Spring Boot backend is running
VITE_API_BASE_URL=http://localhost:8081
