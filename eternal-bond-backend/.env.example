# ============================================================
# Eternal Bond — Backend Environment Variables (Spring Boot)
# ============================================================
# Copy this file to .env (inside eternal-bond-backend/) and fill in your own values.
# The application reads these via: spring.config.import=optional:file:./.env[.properties]

# ---- Database (Supabase PostgreSQL) ----
DB_URL=jdbc:postgresql://your-pooler-host.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your_database_password

# ---- Supabase ----
# JWT Secret: Supabase Dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_URL=https://your-project-ref.supabase.co
# Anon key (public by design, but kept backend-only for server-to-server calls)
SUPABASE_ANON_KEY=your_supabase_anon_key

# ---- Email / SMTP (Mailtrap or production provider) ----
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password

# ---- Google OAuth2 ----
# Google Cloud Console → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- Frontend URL (for OAuth redirects) ----
FRONTEND_URL=http://localhost:8080

# ---- Free Astrology API ----
# https://freeastrologyapi.com → Dashboard → API Key
FREE_ASTROLOGY_API_KEY=your_astrology_api_key
FREE_ASTROLOGY_API_BASE_URL=https://json.freeastrologyapi.com

# ---- Stripe ----
# Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
# Stripe Dashboard → Developers → Webhooks → Signing Secret
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret
